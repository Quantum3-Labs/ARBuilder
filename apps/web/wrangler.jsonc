{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arbbuilder",
	"main": "worker.ts",
	"find_additional_modules": true,
	"compatibility_date": "2025-12-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "arbbuilder"
		}
	],
	"observability": {
		"enabled": true
	},

	// Cron trigger for periodic source ingestion (every 6 hours)
	"triggers": {
		"crons": ["0 */6 * * *"]
	},

	// D1 Database for users, API keys, and usage logs
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arbbuilder",
			"database_id": "0ac9b905-424a-46a4-a85a-51c2b74d6cc0"
		}
	],

	// Vectorize for RAG embeddings (BGE-M3, 1024 dimensions)
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "arbbuilder"
		}
	],

	// Workers AI for embeddings and reranking
	"ai": {
		"binding": "AI"
	},

	// Queue for async ingestion (large repos)
	"queues": {
		"producers": [{ "binding": "INGEST_QUEUE", "queue": "arbbuilder-ingest" }],
		"consumers": [{ "queue": "arbbuilder-ingest", "max_batch_size": 1, "max_retries": 3 }]
	},

	// KV for caching
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "c4313f5cd3da4910a5eaccac300ef25b"
		}
	],

	// Environment variables (public values)
	"vars": {
		"NEXTJS_ENV": "production",
		"NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAACfG3f3JlJLMeZSq",
		"AUTH_TRUST_HOST": "true"
	}
}
