{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arbbuilder",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-12-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "arbbuilder"
		}
	],
	"observability": {
		"enabled": true
	},

	// D1 Database for users, API keys, and usage logs
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arbbuilder",
			"database_id": "1a6bb2b5-98f9-4578-aa23-b570ce297ca7"
		}
	],

	// Vectorize for RAG embeddings (BGE-M3, 1024 dimensions)
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "arbbuilder"
		}
	],

	// Workers AI for embeddings and reranking
	"ai": {
		"binding": "AI"
	},

	// KV for caching
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "58e7ca1020924439be4d058ac29b2dfa"
		}
	],

	// NOTE: Containers are NOT included here for local dev.
	// Use wrangler.jsonc for production deploys with containers.

	// Migrations to clean up Durable Objects from previous container-based deploys
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ScraperContainer"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["BatchJobDO"]
		},
		{
			"tag": "v3",
			"deleted_classes": ["ScraperContainer", "BatchJobDO"]
		}
	],

	// Environment variables (public values)
	"vars": {
		"NEXTJS_ENV": "production",
		"NEXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAACIQxZ8Nm_BXUfce",
		"AUTH_TRUST_HOST": "true"
	}
}
