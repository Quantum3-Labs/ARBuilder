# Slim Python scraper container - NO Playwright (under 2GB disk limit)
FROM python:3.11-slim

# Install only git (no browser dependencies needed)
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy source files
COPY container/server_lite.py ./server.py
COPY src/preprocessing/ ./src/preprocessing/
COPY src/utils/ ./src/utils/

# Install slim dependencies (no crawl4ai/playwright)
RUN pip install --no-cache-dir \
    gunicorn \
    flask \
    httpx \
    beautifulsoup4 \
    markdownify \
    tiktoken \
    pydantic \
    tenacity \
    python-dotenv \
    rich

# Expose port
EXPOSE 8080

# Run the server
CMD ["gunicorn", "-b", "0.0.0.0:8080", "-w", "1", "--timeout", "600", "server:app"]
