{
  "main_version": "0.10.0",
  "minimum_version": "0.8.0",
  "deprecated_below": "0.8.0",
  "versions": {
    "0.10.0": {
      "status": "main",
      "alloy_primitives": "1.0.1",
      "alloy_sol_types": "1.0.1",
      "breaking_changes": [
        "msg::sender() replaced with self.vm().msg_sender()",
        "msg::value() replaced with self.vm().msg_value()",
        "evm::log() replaced with self.vm().log()",
        "Requires Stylus.toml with [workspace], [workspace.networks], and [contract] sections",
        "Requires rust-toolchain.toml with channel 1.88.0",
        "alloy-primitives upgraded to 1.0.1 (no longer pinned)",
        "ruint pin no longer needed"
      ],
      "released": "2026-01"
    },
    "0.9.2": {
      "status": "supported",
      "alloy_primitives": "=0.8.20",
      "alloy_sol_types": "=0.8.20",
      "breaking_changes": [
        "Latest stable release with alloy 0.8.x compatibility"
      ],
      "released": "2025-01"
    },
    "0.9.0": {
      "status": "supported",
      "alloy_primitives": "=0.8.20",
      "alloy_sol_types": "=0.8.20",
      "breaking_changes": [
        "Updated to alloy 0.9.x ecosystem"
      ],
      "released": "2024-12"
    },
    "0.8.4": {
      "status": "supported",
      "alloy_primitives": "0.8.14",
      "alloy_sol_types": "0.8.14",
      "breaking_changes": [
        "Minor fixes and improvements"
      ],
      "released": "2024-10"
    },
    "0.8.0": {
      "status": "minimum",
      "alloy_primitives": "0.8.0",
      "alloy_sol_types": "0.8.0",
      "breaking_changes": [
        "#[external] deprecated in favor of #[public]",
        "Error handling changed to Result<T, Vec<u8>>"
      ],
      "released": "2024-08"
    },
    "0.6.0": {
      "status": "deprecated",
      "alloy_primitives": "0.7.0",
      "alloy_sol_types": "0.7.0",
      "breaking_changes": [],
      "released": "2024-03"
    }
  },
  "version_patterns": {
    "0.10": {
      "attributes": ["#[public]", "#[entrypoint]"],
      "imports": ["stylus_sdk::prelude::*"],
      "storage_macro": "sol_storage!",
      "error_handling": "Result<T, Vec<u8>>",
      "cfg_attr": "#![cfg_attr(not(feature = \"export-abi\"), no_main)]",
      "sender": "self.vm().msg_sender()",
      "value": "self.vm().msg_value()",
      "log": "self.vm().log(Event)",
      "transfer_eth": "transfer_eth(self, to, amount) from stylus_sdk::call::transfer",
      "error_import": "use alloy_sol_types::SolError;",
      "error_derive": "#[derive(SolidityError)]",
      "forbidden_modules": ["stylus_sdk::evm", "stylus_sdk::msg"],
      "required_files": ["Stylus.toml", "rust-toolchain.toml"]
    },
    "0.9": {
      "attributes": ["#[public]", "#[entrypoint]"],
      "imports": ["stylus_sdk::prelude::*"],
      "storage_macro": "sol_storage!",
      "error_handling": "Result<T, Vec<u8>>",
      "cfg_attr": "#![cfg_attr(not(feature = \"export-abi\"), no_main)]",
      "sender": "msg::sender()"
    },
    "0.8": {
      "attributes": ["#[public]", "#[entrypoint]"],
      "imports": ["stylus_sdk::prelude::*"],
      "storage_macro": "sol_storage!",
      "error_handling": "Result<T, Vec<u8>>",
      "cfg_attr": "#![cfg_attr(not(feature = \"export-abi\"), no_main)]",
      "sender": "msg::sender()"
    },
    "0.6": {
      "attributes": ["#[external]", "#[entrypoint]"],
      "imports": ["stylus_sdk::prelude::*"],
      "storage_macro": "sol_storage!",
      "error_handling": "Result<T, StylusError>",
      "cfg_attr": "#![cfg_attr(not(feature = \"export-abi\"), no_main, no_std)]",
      "sender": "msg::sender()"
    }
  },
  "deprecation_warnings": {
    "below_minimum": "Your project uses stylus-sdk {version} which is below the minimum supported version ({minimum}). Please upgrade to at least v{minimum} for full support.",
    "deprecated_attribute": "The #[external] attribute is deprecated since v0.8.0. Use #[public] instead.",
    "deprecated_api": "msg::sender(), msg::value(), and evm::log() are deprecated since v0.10.0. Use self.vm().msg_sender(), self.vm().msg_value(), and self.vm().log() instead."
  }
}
